{
  "name": "relay-onboarding-examples-rescript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names vite,rescript,relay \"vite\" \"rescript watch\" \"rescript-relay-compiler --watch\"",
    "build": "pnpm run relay && pnpm run typecheck && vite build",
    "format:check": "rescript format --check src/*.res",
    "preview": "vite preview",
    "relay": "rescript-relay-compiler",
    "typecheck": "rescript build"
  },
  "dependencies": {
    "@rescript/core": "catalog:",
    "@rescript/react": "catalog:",
    "@rescript/runtime": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-relay": "catalog:",
    "react-router-dom": "catalog:",
    "relay-runtime": "catalog:",
    "rescript-relay": "catalog:",
    "rescript-webapi": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "catalog:",
    "relay-test-utils": "catalog:",
    "rescript": "catalog:",
    "vite": "catalog:"
  }
}
